#!/bin/bash
# hektor — the Hektor pack CLI.
#
# The headline command:
#   hektor package install          wire the whole pack into the current repo
#                                    (Claude Code + Cursor + AGENTS.md), one shot.
#
# Other commands:
#   hektor package install [--project DIR] [--harness all|claude|cursor|agents]
#   hektor package status  [--project DIR]     what's installed in a repo
#   hektor package uninstall [--project DIR]   remove Hektor from a repo
#   hektor package link    [--dir BIN]         put `hektor` on PATH (default ~/.local/bin)
#   hektor package unlink  [--dir BIN]
#   hektor help | version
#
# Run it from your target repo after adding the hektor directory to it:
#   ./hektor/hektor package install         (or `hektor package install` once linked)
set -uo pipefail

# Resolve through symlinks so PACK_DIR is the real pack even when `hektor` is a
# symlink on PATH (created by `hektor package link`).
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
PACK_DIR="$(cd -P "$(dirname "$SRC")" && pwd)"

die() { echo "hektor: $*" >&2; exit 1; }

usage() {
  sed -n '3,20p' "$PACK_DIR/hektor" | sed 's/^# \{0,1\}//'
}

# Default target repo: the git toplevel of where you run the command. If run from
# inside the pack, target the repo that CONTAINS the pack. Never the pack itself.
default_project() {
  local base
  case "$PWD/" in
    "$PACK_DIR"/*) base="$PACK_DIR/.." ;;
    *)             base="$PWD" ;;
  esac
  git -C "$base" rev-parse --show-toplevel 2>/dev/null || (cd "$base" && pwd)
}

# ---- package subcommands ----------------------------------------------------
pkg_install() {
  local proj="" harness="all"
  while [ $# -gt 0 ]; do case "$1" in
    --project) proj="${2:-}"; shift 2 ;;
    --harness) harness="${2:-all}"; shift 2 ;;
    *) die "install: unknown arg: $1" ;;
  esac; done
  [ -n "$proj" ] || proj="$(default_project)"
  [ -d "$proj" ] || die "install: no such project dir: $proj"
  proj="$(cd "$proj" && pwd)"
  [ "$proj" = "$PACK_DIR" ] && die "install: refusing to install into the pack itself.
Run this from your target repo, or pass --project <your-repo>."
  echo "hektor: installing into $proj (harness: $harness)"
  exec bash "$PACK_DIR/install.sh" --harness "$harness" --project "$proj"
}

pkg_status() {
  local proj=""
  while [ $# -gt 0 ]; do case "$1" in --project) proj="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$proj" ] || proj="$(default_project)"
  [ -d "$proj" ] || die "status: no such project dir: $proj"
  proj="$(cd "$proj" && pwd)"
  echo "hektor status — $proj"
  local ok="  ✓" no="  ✗"
  local n; n=$(ls -d "$proj"/.claude/skills/hektor-* 2>/dev/null | wc -l | tr -d ' ')
  [ "${n:-0}" -gt 0 ] && echo "$ok skills:        $n installed (.claude/skills/hektor-*)" || echo "$no skills:        none"
  [ -f "$proj/.claude/hooks/pr-rules-gate.sh" ] && echo "$ok pr-rules-gate: present" || echo "$no pr-rules-gate: missing"
  if [ -f "$proj/.claude/settings.json" ] && command -v jq >/dev/null && \
     jq -e '[.hooks[]?[]?.hooks[]?.command // empty] | any(contains("pr-rules-gate"))' "$proj/.claude/settings.json" >/dev/null 2>&1; then
    echo "$ok Claude gates:  registered in .claude/settings.json"
  else
    echo "$no Claude gates:  not registered"
  fi
  [ -f "$proj/.cursor/rules/hektor.mdc" ] && echo "$ok Cursor:        rule + adapter wired (.cursor/)" || echo "$no Cursor:        not wired"
  [ -f "$proj/AGENTS.md" ] && grep -qF 'hektor:begin' "$proj/AGENTS.md" 2>/dev/null && echo "$ok AGENTS.md:      pointer present" || echo "$no AGENTS.md:      no pointer"
}

pkg_uninstall() {
  local proj=""
  while [ $# -gt 0 ]; do case "$1" in --project) proj="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$proj" ] || proj="$(default_project)"
  [ -d "$proj" ] || die "uninstall: no such project dir: $proj"
  proj="$(cd "$proj" && pwd)"
  command -v jq >/dev/null || die "uninstall: jq is required"
  echo "hektor: removing Hektor from $proj"

  # Skills + schemas we shipped.
  rm -rf "$proj"/.claude/skills/hektor-* 2>/dev/null || true

  # Hooks we shipped (by basename), + strip their registrations from settings.json.
  local names_json
  names_json=$( (cd "$PACK_DIR/hooks" && ls *.sh 2>/dev/null) | jq -R . | jq -s . )
  while IFS= read -r h; do rm -f "$proj/.claude/hooks/$h" 2>/dev/null || true; done \
    < <(cd "$PACK_DIR/hooks" && ls *.sh 2>/dev/null)
  local S="$proj/.claude/settings.json"
  if [ -f "$S" ]; then
    local t; t="$(mktemp)"
    jq --argjson names "$names_json" '
      if .hooks == null then . else
        .hooks |= (
          map_values(
            map(.hooks |= map(select(
              (.command // "") as $c
              | (($names | any(. as $n | $c | contains("/.claude/hooks/" + $n)))
                 or ($c | contains("hektor-flaky-triage/hooks/"))) | not
            )))
            | map(select((.hooks | length) > 0))
          )
          | map_values(select(length > 0))
        )
      end
    ' "$S" > "$t" 2>/dev/null && mv "$t" "$S" || rm -f "$t"
  fi

  # Cursor adapter + rule, + strip .cursor/hooks.json registrations.
  rm -f "$proj/.cursor/hooks/adapter.sh" "$proj/.cursor/hooks/lib/cursor-compat.sh" "$proj/.cursor/rules/hektor.mdc" 2>/dev/null || true
  local H="$proj/.cursor/hooks.json"
  if [ -f "$H" ]; then
    local t; t="$(mktemp)"
    jq 'if .hooks == null then . else
          .hooks |= with_entries(.value |= map(select((.command // "") | contains(".cursor/hooks/adapter.sh") | not)))
        end' "$H" > "$t" 2>/dev/null && mv "$t" "$H" || rm -f "$t"
  fi

  # AGENTS.md pointer block.
  local AG="$proj/AGENTS.md"
  if [ -f "$AG" ] && grep -qF 'hektor:begin' "$AG"; then
    local t; t="$(mktemp)"
    sed '/<!-- hektor:begin -->/,/<!-- hektor:end -->/d' "$AG" > "$t" && mv "$t" "$AG"
  fi
  echo "hektor: removed (skills, hooks, Cursor wiring, AGENTS.md pointer). Your other .claude/.cursor entries are untouched."
}

pkg_link() {
  local bindir=""
  while [ $# -gt 0 ]; do case "$1" in --dir) bindir="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$bindir" ] || bindir="$HOME/.local/bin"
  mkdir -p "$bindir" || die "link: cannot create $bindir"
  ln -sf "$PACK_DIR/hektor" "$bindir/hektor"
  echo "hektor: linked $bindir/hektor -> $PACK_DIR/hektor"
  case ":$PATH:" in
    *":$bindir:"*) echo "hektor: '$bindir' is on PATH — run 'hektor package install' from any repo." ;;
    *) echo "hektor: add '$bindir' to PATH, then 'hektor package install' works bare:
         echo 'export PATH=\"$bindir:\$PATH\"' >> ~/.zshrc && source ~/.zshrc" ;;
  esac
}

pkg_unlink() {
  local bindir=""
  while [ $# -gt 0 ]; do case "$1" in --dir) bindir="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$bindir" ] || bindir="$HOME/.local/bin"
  if [ -L "$bindir/hektor" ]; then rm -f "$bindir/hektor"; echo "hektor: unlinked $bindir/hektor"; else echo "hektor: no symlink at $bindir/hektor"; fi
}

pkg() {
  local sub="${1:-help}"; shift 2>/dev/null || true
  case "$sub" in
    install)   pkg_install "$@" ;;
    uninstall) pkg_uninstall "$@" ;;
    status)    pkg_status "$@" ;;
    link)      pkg_link "$@" ;;
    unlink)    pkg_unlink "$@" ;;
    help|-h|--help) usage ;;
    *) die "package: unknown subcommand '$sub' (try: install|status|uninstall|link|unlink)" ;;
  esac
}

# ---- top-level dispatch -----------------------------------------------------
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  package)          pkg "$@" ;;
  install)          pkg install "$@" ;;   # convenience: `hektor install` == `hektor package install`
  status)           pkg status "$@" ;;
  doctor)           exec bash "$PACK_DIR/scripts/doctor.sh" "$@" ;;
  help|-h|--help)   usage ;;
  version|-v|--version)
    echo "hektor pack v$(jq -r '.version // "?"' "$PACK_DIR/catalog.json" 2>/dev/null || echo '?') ($PACK_DIR)" ;;
  *) die "unknown command '$cmd' (try: package install | status | help | version)" ;;
esac
