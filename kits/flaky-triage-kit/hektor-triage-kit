#!/bin/bash
# hektor-triage-kit — the kit's command-line entrypoint.
#
#   hektor-triage-kit install [--harness all|claude|cursor|agents|both] [--project <dir>] [--no-autoconfig]
#       Install into a repo and wire EVERY harness (Claude Code + Cursor + AGENTS.md) in one shot, and
#       auto-detect JDK 17 + source_roots so there is no manual config step. Idempotent.
#   hektor-triage-kit build
#       Pack the kit into a versioned tarball (npm pack) and VERIFY it: no .lock-state,
#       no dev cruft, and a packed install.sh identical to the source's. Source checkout
#       only — an installed kit carries no manifest. A failed verification deletes the
#       artifact rather than leaving a bad one on disk.
#   hektor-triage-kit lock | unlock | status
#       OS-level protection tier for an installed kit (proxies core/lock-kit.sh in the target repo):
#       hardened (root-owned, password-gated reopen — the wall the PreToolUse gate is not) when sudo is
#       available, else a chmod-only degraded tier the same user can reverse. `status` names the tier
#       that actually holds AND the owner of every surface path — the only way to see a chown that
#       applied to some paths and not others. What hardened does NOT cover is listed in full in
#       core/lock-kit.sh's header; read it before calling a kit protected.
#   hektor-triage-kit link [<bindir>]
#       Symlink this command onto PATH (default ~/.local/bin) so `hektor-triage-kit` works from anywhere.
#   hektor-triage-kit --version
#       The version of THIS SOURCE checkout, read from package.json. `status` answers the other
#       question — which version a given PROJECT was installed from — by reading that project's
#       core/.version. An installed kit has no manifest, so --version there says to ask `status`.
#   hektor-triage-kit help
set -uo pipefail
# Resolve the symlink chain BEFORE taking dirname. npm's `bin` mechanism always
# installs this command as a symlink — `<prefix>/bin/hektor-triage-kit ->
# ../lib/node_modules/hektor-flaky-triage/hektor-triage-kit` for a global install,
# `node_modules/.bin/hektor-triage-kit` for npx — and bash runs with the SYMLINK's
# path in BASH_SOURCE. A bare dirname therefore yields npm's bin directory, where
# `exec "$HERE/install.sh"` dies with rc 126 and `link` would relink the symlink to
# itself. That is EVERY npm consumption path, i.e. the whole reason this package
# exists. macOS ships bash 3.2 and BSD readlink, so there is no `readlink -f`: walk
# the chain by hand, resolving each relative target (npm's ARE relative) against the
# directory of the link that named it. No cycle guard: the kernel resolved this
# whole chain to a real file already — a loop is ELOOP at exec, before line 1 runs —
# so the walk is guaranteed to terminate and a bound here would be dead code.
_src="${BASH_SOURCE[0]:-$0}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
HERE="$(cd -P "$(dirname "$_src")" && pwd)"
unset _src _dir
sub="${1:-help}"; [ $# -gt 0 ] && shift

case "$sub" in
  install)
    exec "$HERE/install.sh" "$@" ;;

  lock|unlock|status)
    PROJ="$(pwd)"
    # allow: hektor-triage-kit lock --project <dir>
    [ "${1:-}" = "--project" ] && { PROJ="${2:-$PROJ}"; }
    LK="$PROJ/.claude/skills/hektor-flaky-triage/core/lock-kit.sh"
    [ -f "$LK" ] || { echo "hektor-triage-kit: kit not installed in $PROJ — run: hektor-triage-kit install" >&2; exit 66; }
    if [ "$sub" = "status" ]; then
      V="$PROJ/.claude/skills/hektor-flaky-triage/core/.version"
      if [ -r "$V" ]; then
        echo "  kit version: $(cut -d' ' -f1 < "$V") (installed $(cut -d' ' -f2 < "$V"))"
      else
        echo "  kit version: unknown (installed before the kit recorded versions)"
      fi
    fi
    exec "$LK" "$sub" ;;

  link)
    BINDIR="${1:-$HOME/.local/bin}"; mkdir -p "$BINDIR"
    ln -sf "$HERE/hektor-triage-kit" "$BINDIR/hektor-triage-kit"
    echo "linked -> $BINDIR/hektor-triage-kit"
    case ":$PATH:" in *":$BINDIR:"*) ;; *) echo "note: add $BINDIR to PATH to call 'hektor-triage-kit' from anywhere" ;; esac ;;

  build)
    # Source-checkout only: an install carries SKILL.md and core/ and nothing
    # else, so there is no manifest to pack. Say which directory to use rather
    # than failing obscurely inside npm.
    [ -f "$HERE/package.json" ] || {
      echo "hektor-triage-kit: build needs the kit SOURCE checkout (no package.json in $HERE)." >&2
      echo "hektor-triage-kit: an installed kit carries only SKILL.md and core/. Run build from kits/flaky-triage-kit." >&2
      exit 66; }
    # An UNPACKED TARBALL passes the check above — npm ships package.json in every
    # tarball — but `scripts/` is deliberately outside the `files` whitelist, so the
    # prepack target is missing and npm pack dies on that. Diagnosed here, because
    # the failure downstream used to be reported as a hostname leak and sent people
    # hunting for a disclosure that never happened.
    [ -f "$HERE/scripts/scan-kit.sh" ] || {
      echo "hektor-triage-kit: build needs the kit SOURCE checkout (package.json is here, scripts/scan-kit.sh is not)." >&2
      echo "hektor-triage-kit: this looks like an UNPACKED TARBALL — scripts/ is not in the npm files whitelist, so a" >&2
      echo "hektor-triage-kit: packaged kit carries no packaging tooling and cannot repack itself. Nothing is wrong with" >&2
      echo "hektor-triage-kit: this tree. Run build from the source checkout at kits/flaky-triage-kit." >&2
      exit 66; }
    command -v npm >/dev/null 2>&1 || { echo "hektor-triage-kit: build requires npm" >&2; exit 69; }
    # cwd is the kit root on purpose: `npm pack` writes to the CURRENT directory,
    # so inheriting the caller's would scatter artifacts wherever they stood.
    # npm's stderr is CAPTURED, not discarded: it carries the prepack scan's own
    # refusal lines, and swallowing them is what left this failure with a guessed
    # cause printed as a certainty.
    PACKERR="$(mktemp)"
    TGZ="$(cd "$HERE" && npm pack --silent 2>"$PACKERR" | tail -1)"
    [ -n "$TGZ" ] && [ -f "$HERE/$TGZ" ] || {
      echo "hektor-triage-kit: build FAILED — npm pack wrote no artifact. npm and the prepack scan said:" >&2
      sed 's/^/hektor-triage-kit:   /' "$PACKERR" >&2
      echo "hektor-triage-kit: (a 'REFUSING — internal hostname' line above means the prepack scan found a leak; anything" >&2
      echo "hektor-triage-kit:  else is npm's own failure and has nothing to do with hostnames.)" >&2
      rm -f "$PACKERR"
      exit 70; }
    rm -f "$PACKERR"
    # Verify what was actually produced. The retired zip packaged cleanly and was
    # still wrong; a build that does not read its own output cannot say otherwise.
    bad=0
    for pat in 'lock-state' '\.achilles/' '\.playwright-mcp/' '\.DS_Store' '\.png$' '\.superpowers/' '^package/scripts/'; do
      if tar tzf "$HERE/$TGZ" 2>/dev/null | grep -qE "$pat"; then
        echo "hektor-triage-kit: build FAILED — artifact contains $pat" >&2; bad=1
      fi
    done
    T="$(mktemp -d)"
    if tar xzf "$HERE/$TGZ" -C "$T" package/install.sh 2>/dev/null; then
      cmp -s "$T/package/install.sh" "$HERE/install.sh" || {
        echo "hektor-triage-kit: build FAILED — the packed install.sh differs from the source's" >&2; bad=1; }
    else
      echo "hektor-triage-kit: build FAILED — the artifact has no package/install.sh" >&2; bad=1
    fi
    rm -rf "$T"
    [ "$bad" = 0 ] || { rm -f "$HERE/$TGZ"; echo "hektor-triage-kit: removed the bad artifact" >&2; exit 71; }
    echo "built: $HERE/$TGZ"
    echo "install it with:  npm i -g $HERE/$TGZ   (then: hektor-triage-kit install)"
    echo "or run directly:  npx $HERE install --harness claude" ;;

  -V|--version)
    # The SOURCE's version, from the one manifest that carries it. `status` answers
    # the different question — what version a given PROJECT was installed from — by
    # reading core/.version out of that project. Two questions, two commands, one
    # manifest: nothing here may become a second place a version is written down.
    [ -f "$HERE/package.json" ] || {
      echo "hektor-triage-kit: --version reads package.json and there is none in $HERE." >&2
      echo "hektor-triage-kit: an installed kit carries no manifest — ask the PROJECT instead: hektor-triage-kit status" >&2
      exit 66; }
    _v=""
    if command -v jq >/dev/null 2>&1; then _v="$(jq -r '.version // empty' "$HERE/package.json" 2>/dev/null)"; fi
    # jq is required by install.sh but not by this: reporting a version must not be
    # the one command that needs a tool installed to answer.
    [ -n "$_v" ] || _v="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HERE/package.json" | head -1)"
    [ -n "$_v" ] || { echo "hektor-triage-kit: package.json in $HERE names no version" >&2; exit 70; }
    echo "hektor-triage-kit $_v ($HERE)" ;;

  -h|--help|help)
    sed -n '2,25p' "${BASH_SOURCE[0]:-$0}" | sed 's/^# \{0,1\}//' ;;

  *)
    echo "hektor-triage-kit: unknown subcommand '$sub' (try: install | build | lock | unlock | status | link | --version | help)" >&2
    exit 64 ;;
esac
