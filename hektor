#!/bin/bash
# hektor — the Hektor pack CLI.
#
# The headline command:
#   hektor package install          wire the whole pack into the current repo, one shot.
#
# Other commands:
#   hektor package install [--project DIR] [--no-kits]
#   hektor package status  [--project DIR]     what's installed in a repo
#   hektor package uninstall [--project DIR]   remove Hektor from a repo
#   hektor package link    [--dir BIN]         put `hektor` on PATH (default ~/.local/bin)
#   hektor package unlink  [--dir BIN]
#   hektor doctor [--project DIR]              self-audit the pack
#   hektor help | version
#
# Run it from your target repo after adding the hektor directory to it:
#   ./hektor/hektor package install         (or `hektor package install` once linked)
set -uo pipefail

# Resolve through symlinks so PACK_DIR is the real pack even when `hektor` is a
# symlink on PATH (created by `hektor package link`).
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
PACK_DIR="$(cd -P "$(dirname "$SRC")" && pwd)"

die() { echo "hektor: $*" >&2; exit 1; }

usage() {
  sed -n '3,17p' "$PACK_DIR/hektor" | sed 's/^# \{0,1\}//'
}

# Default target repo: the git toplevel of where you run the command. If run from
# inside the pack, target the repo that CONTAINS the pack. Never the pack itself.
default_project() {
  local base
  case "$PWD/" in
    "$PACK_DIR"/*) base="$PACK_DIR/.." ;;
    *)             base="$PWD" ;;
  esac
  git -C "$base" rev-parse --show-toplevel 2>/dev/null || (cd "$base" && pwd)
}

# ---- package subcommands ----------------------------------------------------
pkg_install() {
  local proj="" pass=()
  while [ $# -gt 0 ]; do case "$1" in
    --project) proj="${2:-}"; shift 2 ;;
    --no-kits) pass+=(--no-kits); shift ;;
    --harness) shift 2 ;;   # accepted and ignored: the pack targets Cursor only
    *) die "install: unknown arg: $1" ;;
  esac; done
  [ -n "$proj" ] || proj="$(default_project)"
  [ -d "$proj" ] || die "install: no such project dir: $proj"
  proj="$(cd "$proj" && pwd)"
  [ "$proj" = "$PACK_DIR" ] && die "install: refusing to install into the pack itself.
Run this from your target repo, or pass --project <your-repo>."
  echo "hektor: installing into $proj"
  exec bash "$PACK_DIR/install.sh" --project "$proj" ${pass+"${pass[@]}"}
}

pkg_status() {
  local proj=""
  while [ $# -gt 0 ]; do case "$1" in --project) proj="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$proj" ] || proj="$(default_project)"
  [ -d "$proj" ] || die "status: no such project dir: $proj"
  proj="$(cd "$proj" && pwd)"
  echo "hektor status — $proj"
  local ok="  ✓" no="  ✗" C="$proj/.cursor"

  local n; n=$(ls -d "$C"/skills/*/ 2>/dev/null | wc -l | tr -d ' ')
  [ "${n:-0}" -gt 0 ] && echo "$ok skills:    $n installed (.cursor/skills/)" || echo "$no skills:    none"

  local a; a=$(ls "$C"/agents/hektor-*.md 2>/dev/null | wc -l | tr -d ' ')
  [ "${a:-0}" -gt 0 ] && echo "$ok agents:    $a subagent roles (.cursor/agents/)" || echo "$no agents:    none"

  [ -f "$C/rules/hektor-kernel.mdc" ] && echo "$ok rule:      hektor-kernel.mdc (always applied)" || echo "$no rule:      missing"

  local g; g=$(ls "$C"/hooks/*.sh 2>/dev/null | wc -l | tr -d ' ')
  [ "${g:-0}" -gt 0 ] && echo "$ok gates:     $g scripts in .cursor/hooks/" || echo "$no gates:     none"

  if [ -f "$C/hooks.json" ] && command -v jq >/dev/null; then
    local r; r=$(jq '[.hooks[]?[]? | select((.command // "") | contains(".cursor/hooks/"))] | length' "$C/hooks.json" 2>/dev/null || echo 0)
    if [ "${r:-0}" -gt 0 ]; then
      echo "$ok wiring:    $r registrations in .cursor/hooks.json"
      jq -r '.hooks | to_entries[] | "             \(.key): \(.value | length)"' "$C/hooks.json" 2>/dev/null
    else
      echo "$no wiring:    hooks.json present but no Hektor registrations"
    fi
  else
    echo "$no wiring:    no .cursor/hooks.json"
  fi

  # A registration naming a script that isn't there is worse than no registration:
  # the harness silently runs nothing while status would otherwise report "wired".
  if [ -f "$C/hooks.json" ] && command -v jq >/dev/null; then
    local dangling=0 cmd path
    while IFS= read -r cmd; do
      [ -n "$cmd" ] || continue
      path="${cmd#./}"
      [ -f "$proj/$path" ] || { echo "  ! dangling: $cmd names no file"; dangling=$((dangling+1)); }
    done < <(jq -r '.hooks[]?[]? | select((.command // "") | contains(".cursor/hooks/")) | .command' "$C/hooks.json" 2>/dev/null)
    [ "$dangling" -gt 0 ] && echo "  ! $dangling registration(s) point at a missing script — re-run 'hektor package install'"
  fi
}

pkg_uninstall() {
  local proj=""
  while [ $# -gt 0 ]; do case "$1" in --project) proj="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$proj" ] || proj="$(default_project)"
  [ -d "$proj" ] || die "uninstall: no such project dir: $proj"
  proj="$(cd "$proj" && pwd)"
  command -v jq >/dev/null || die "uninstall: jq is required"
  echo "hektor: removing Hektor from $proj"
  local C="$proj/.cursor"

  # Skills the pack ships, by name — never a blanket wipe of .cursor/skills/, which
  # is a shared directory other tools install into.
  local sk
  while IFS= read -r sk; do
    [ -n "$sk" ] && rm -rf "$C/skills/$sk" 2>/dev/null || true
  done < <(cd "$PACK_DIR/skills" 2>/dev/null && ls -d */ 2>/dev/null | sed 's#/$##')

  # Agents, the rule, the shipped READMEs, and the return schemas.
  rm -f "$C"/agents/hektor-*.md "$C/agents/README.md" "$C/rules/hektor-kernel.mdc" \
        "$C/skills/README.md" "$C/hooks/README.md" 2>/dev/null || true
  rm -rf "$C/schemas/subagent-returns" 2>/dev/null || true
  rm -f "$C/schemas/verifier-result.schema.json" 2>/dev/null || true

  # Gates we shipped (by basename), and their registrations.
  local h
  while IFS= read -r h; do rm -f "$C/hooks/$h" 2>/dev/null || true; done \
    < <(cd "$PACK_DIR/hooks" && ls *.sh 2>/dev/null)
  rm -f "$C/hooks/lib/cursor.sh" "$C/hooks/lib/audit.sh" "$C/hooks/lib/hook_profile.sh" 2>/dev/null || true

  local H="$C/hooks.json"
  if [ -f "$H" ]; then
    local names_json t
    names_json=$( (cd "$PACK_DIR/hooks" && ls *.sh 2>/dev/null) | jq -R . | jq -s . )
    t="$(mktemp)"
    # Drop only registrations naming a script THIS pack ships. An entry you added
    # to the same event, or another tool's, is left exactly as it was — and an
    # event left empty is dropped rather than kept as a bare [].
    jq --argjson names "$names_json" '
      if .hooks == null then . else
        .hooks |= (
          with_entries(.value |= map(select(
            (.command // "") as $c
            | ($names | any(. as $n | $c | contains(".cursor/hooks/" + $n))) | not
          )))
          | with_entries(select((.value | length) > 0))
        )
      end
    ' "$H" > "$t" 2>/dev/null && mv "$t" "$H" || rm -f "$t"
  fi

  # rmdir, never rm -rf: each only succeeds if the directory is now empty, so a
  # directory still holding something you own is left exactly where it is.
  rmdir "$C/agents" "$C/rules" "$C/hooks/lib" "$C/hooks" "$C/skills" "$C/schemas" 2>/dev/null || true
  echo "hektor: removed (skills, agents, rule, gates, registrations)."
  echo "hektor: left alone — docs/hektor/ (your run state) and any .cursor entry this pack didn't ship."
}

pkg_link() {
  local bindir=""
  while [ $# -gt 0 ]; do case "$1" in --dir) bindir="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$bindir" ] || bindir="$HOME/.local/bin"
  mkdir -p "$bindir" || die "link: cannot create $bindir"
  ln -sf "$PACK_DIR/hektor" "$bindir/hektor"
  echo "hektor: linked $bindir/hektor -> $PACK_DIR/hektor"
  case ":$PATH:" in
    *":$bindir:"*) echo "hektor: '$bindir' is on PATH — run 'hektor package install' from any repo." ;;
    *) echo "hektor: add '$bindir' to PATH, then 'hektor package install' works bare:
         echo 'export PATH=\"$bindir:\$PATH\"' >> ~/.zshrc && source ~/.zshrc" ;;
  esac
}

pkg_unlink() {
  local bindir=""
  while [ $# -gt 0 ]; do case "$1" in --dir) bindir="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$bindir" ] || bindir="$HOME/.local/bin"
  if [ -L "$bindir/hektor" ]; then rm -f "$bindir/hektor"; echo "hektor: unlinked $bindir/hektor"; else echo "hektor: no symlink at $bindir/hektor"; fi
}

pkg() {
  local sub="${1:-help}"; shift 2>/dev/null || true
  case "$sub" in
    install)   pkg_install "$@" ;;
    uninstall) pkg_uninstall "$@" ;;
    status)    pkg_status "$@" ;;
    link)      pkg_link "$@" ;;
    unlink)    pkg_unlink "$@" ;;
    help|-h|--help) usage ;;
    *) die "package: unknown subcommand '$sub' (try: install|status|uninstall|link|unlink)" ;;
  esac
}

# ---- top-level dispatch -----------------------------------------------------
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  package)          pkg "$@" ;;
  install)          pkg install "$@" ;;   # convenience: `hektor install` == `hektor package install`
  status)           pkg status "$@" ;;
  doctor)           exec bash "$PACK_DIR/scripts/doctor.sh" "$@" ;;
  help|-h|--help)   usage ;;
  version|-v|--version)
    echo "hektor pack v$(jq -r '.version // "?"' "$PACK_DIR/catalog.json" 2>/dev/null || echo '?') ($PACK_DIR)" ;;
  *) die "unknown command '$cmd' (try: package install | status | doctor | help | version)" ;;
esac
